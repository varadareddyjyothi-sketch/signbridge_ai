# Frontend Environment Variables Template
# Local development only. Copy this file to .env.development so this URL
# is not embedded in production builds.
VITE_API_BASE_URL=http://localhost:8000

# For separate production frontend and backend services, set VITE_API_BASE_URL
# in the frontend hosting provider's build environment to the backend HTTPS origin.
# For a unified deployment where FastAPI serves the frontend, leave it unset.
