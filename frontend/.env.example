# Frontend Environment Variables Template
# For local development with separate Vite dev server:
VITE_API_BASE_URL=http://localhost:8000

# For production on DeployXa:
# If deploying full-stack container, leave VITE_API_BASE_URL empty to use relative API calls.
# If deploying separate frontend and backend services, set VITE_API_BASE_URL to your backend URL:
# VITE_API_BASE_URL=https://your-backend.deployxa.app

# Optional Supabase credentials:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

