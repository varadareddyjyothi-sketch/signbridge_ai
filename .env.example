# SignBridge AI - Environment Configuration Template
# Copy this file to .env for local development or set these variables in your deployment dashboard

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Comma-separated list of allowed origins, or '*' for public access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Machine Learning Configuration
CONFIDENCE_THRESHOLD=0.65

# MongoDB Atlas Cloud Database Configuration (Optional - Local SQLite fallback used if absent)
# Replace with your MongoDB Atlas connection string (Project: 69ba6bd5b08f2ff79b9aa170)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/signbridge_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=signbridge_ai

# Security / JWT Authentication
JWT_SECRET=signbridge_ai_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256

# Frontend Environment Variables (Set in deployment build environment or frontend/.env)
# VITE_API_BASE_URL= (leave empty if served unified from backend, or provide backend URL if separate)
