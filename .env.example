# SignBridge AI - Environment Configuration Template
# Copy this file to .env for local development or set these variables in your deployment dashboard

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Exact comma-separated browser origins. Do not use '*' with session cookies.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Machine Learning Configuration
CONFIDENCE_THRESHOLD=0.65

# MongoDB is required in production. For local development, set this to a
# local MongoDB URI; when unset, the existing persistent SQLite dev fallback is used.
MONGODB_URI=
MONGODB_DB_NAME=signbridge_ai

# Opaque server-side sessions use an HttpOnly cookie; no JWT signing secret is needed.
SESSION_TTL_DAYS=30

# Frontend Environment Variables (Set in deployment build environment or frontend/.env)
# VITE_API_BASE_URL= (leave empty if served unified from backend, or provide backend URL if separate)
