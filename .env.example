# SignBridge AI - Environment Configuration Template
# Copy this file to .env for local development or set these variables in DeployXa dashboard

# Backend API Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Comma-separated list of allowed origins, or '*' for public access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# DeployXa / Production Overrides:
# PORT (assigned automatically by DeployXa)
# HOST=0.0.0.0
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://your-deployxa-subdomain.deployxa.app

# Machine Learning Configuration
CONFIDENCE_THRESHOLD=0.65

# Supabase Cloud Database Configuration (Optional - Local SQLite fallback used if absent)
# Do not commit real production secret keys!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# SUPABASE_SECRET_KEY is only for server-side trusted admin operations; NEVER expose to frontend.
SUPABASE_SECRET_KEY=your-service-role-key-here

# Frontend Environment Variables (Set in DeployXa build environment or frontend/.env)
# VITE_API_BASE_URL= (leave empty if served unified from backend, or provide backend URL if separate)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

