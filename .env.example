# SignBridge AI - Environment Configuration Template
# Copy this file to .env for local development

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Machine Learning Configuration
MODEL_DIR=ml/models
MODEL_FILE=signbridge_rf_model.joblib
METADATA_FILE=model_metadata.json
CONFIDENCE_THRESHOLD=0.65

# Supabase Cloud Database Configuration (Optional - Local SQLite fallback used if absent)
# Do not commit real production secret keys!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# SUPABASE_SECRET_KEY is only for server-side trusted admin operations; NEVER expose to frontend.
SUPABASE_SECRET_KEY=your-service-role-key-here

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
